# Variables que necesita el servidor. Copialo a .env y completa los valores (nunca al repo).
DATABASE_URL=
JWT_SECRET=
CORS_ORIGINS=
ENCARGADO_TELEFONO=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=
UM_AI_API_KEY=
UM_AI_BASE_URL=
UM_AI_MODEL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta (Configuracion > Basica). Con esto se chequea la firma
# X-Hub-Signature-256 del webhook. En Render es OBLIGATORIO: sin esto rechaza todo con 403.
META_APP_SECRET=
# Limite de intentos fallidos de login (opcionales; estos son los valores por defecto)
LOGIN_FALLOS_POR_EMAIL=5
LOGIN_FALLOS_POR_IP=20
LOGIN_VENTANA_MINUTOS=15
# Headers con la IP real del cliente detras de Render/Cloudflare, en orden (opcional)
IP_HEADERS=True-Client-IP,CF-Connecting-IP
